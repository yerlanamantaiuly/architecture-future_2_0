# Пример локальных секретов. Скопируйте в .env (файл в .gitignore).
# AWS_* используются Terraform S3 backend (Yandex Object Storage и MinIO).

AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
YC_TOKEN=replace-me
TF_STATE_BUCKET=future20-tfstate
TF_STATE_ENDPOINT=https://storage.yandexcloud.net
